<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AllRatesToday Rates</label>
    <description>Lets the user run the AllRatesToday exchange rate sync (callouts through the AllRatesToday credential). Assign ART_Salesforce_API_Access too, from config/self-api..</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses><apexClass>ARTRateOptions</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ARTRateSyncBatch</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ARTRateSyncSchedulable</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ARTRateMapper</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ARTRatesClient</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ARTSalesforceWriter</apexClass><enabled>true</enabled></classAccesses>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>AllRatesToday-Default</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
